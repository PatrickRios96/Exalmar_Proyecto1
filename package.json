{
  "name": "exalmar-nextjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/setup-local.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:local": "node scripts/migrate.mjs --local",
    "admin:info": "node scripts/admin-info.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "vercel-build": "node scripts/check-production.mjs && npm run db:migrate && npm run build",
    "test:local": "node tests/local-flow.mjs",
    "test:integration": "node scripts/setup-local.mjs && node tests/run-local-server.mjs",
    "format": "prettier --write src scripts tests *.ts *.json *.md"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
